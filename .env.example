# ==============================================================================
# AgentScore — Multi-Dimensional AI Agent Evaluation Platform
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=AgentScore
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DEBUG=True

# Security & Authentication
# Generate a secure 64-character secret key: `openssl rand -hex 32`
SECRET_KEY=dev_secret_key_change_in_production_89432798432174893274983274
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite supported for local dev)
DATABASE_URL=sqlite:///./agentscore.db
# DATABASE_URL=postgresql://agentscore_user:secure_password@localhost:5432/agentscore

# Background Task & Queue Configuration (Redis + Celery or Local Background Worker)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=False

# Storage Configuration (Local filesystem or S3/Supabase Storage)
STORAGE_PROVIDER=local
STORAGE_BASE_DIR=./storage
# AWS / S3 / Supabase Storage config (when STORAGE_PROVIDER=s3)
# S3_ENDPOINT_URL=
# S3_BUCKET_NAME=agentscore-private-datasets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# CORS & Network Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Evaluation Limits & Security
MAX_UPLOAD_SIZE_MB=50
EVALUATION_TIMEOUT_SECONDS=180
STAGE2_REQUEST_TIMEOUT_SECONDS=10
STAGE2_MAX_CONCURRENCY=5
STAGE2_REPEATED_RUNS=3
ENABLE_SSRF_PROTECTION=True

# Optional LLM Judge Configuration (Used only for qualitative rubric dimensions)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
